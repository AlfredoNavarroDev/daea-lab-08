@model IEnumerable<lab_semana08.Models.Socio>

@{
    ViewData["Title"] = ViewData["Title"] ?? "Socios";
}

<h1>Socios</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<p>
    <a class="btn btn-primary" asp-action="Create">Nuevo socio</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>DNI</th>
            <th>Nombre</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var socio in Model)
        {
            <tr>
                <td>@socio.DNI</td>
                <td>@socio.Nombre</td>
                <td>@socio.Email</td>
            </tr>
        }
    </tbody>
</table>
