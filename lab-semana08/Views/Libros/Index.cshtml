@model IEnumerable<lab_semana08.Models.Libro>

@{
    ViewData["Title"] = ViewData["Title"] ?? "Libros";
}

<h1>Libros</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<p>
    <a class="btn btn-primary" asp-action="Create">Nuevo libro</a>
</p>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="titulo" value="@ViewData["Titulo"]" class="form-control" placeholder="Buscar por título" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Título</th>
            <th>ISBN</th>
            <th>Autor</th>
            <th>Ejemplares</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var libro in Model)
        {
            @await Html.PartialAsync("_LibroRow", libro)
        }
    </tbody>
</table>
