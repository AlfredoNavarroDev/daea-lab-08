@model lab_semana08.Models.Libro

<h1>Eliminar libro</h1>

<p>¿Confirma que desea eliminar el siguiente libro? Esta acción lo marcará como inactivo.</p>

<dl class="row">
    <dt class="col-sm-2">Título</dt>
    <dd class="col-sm-10">@Model.Titulo</dd>

    <dt class="col-sm-2">ISBN</dt>
    <dd class="col-sm-10">@Model.ISBN</dd>

    <dt class="col-sm-2">Autor</dt>
    <dd class="col-sm-10">@Model.AutorNombre</dd>

    <dt class="col-sm-2">Ejemplares</dt>
    <dd class="col-sm-10">@Model.Ejemplares</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="LibroId" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
