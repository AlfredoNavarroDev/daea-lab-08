@model lab_semana08.Models.Libro

<h1>Detalle del libro</h1>

<dl class="row">
    <dt class="col-sm-2">Título</dt>
    <dd class="col-sm-10">@Model.Titulo</dd>

    <dt class="col-sm-2">ISBN</dt>
    <dd class="col-sm-10">@Model.ISBN</dd>

    <dt class="col-sm-2">Autor</dt>
    <dd class="col-sm-10">@Model.AutorNombre</dd>

    <dt class="col-sm-2">Ejemplares</dt>
    <dd class="col-sm-10">@Model.Ejemplares</dd>
</dl>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.LibroId">Editar</a>
<a class="btn btn-secondary" asp-action="Index">Volver al listado</a>
