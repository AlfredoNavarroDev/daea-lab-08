@model lab_semana08.Models.PrestamoCrearViewModel

<h1>Nuevo préstamo</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="SocioId" class="form-label"></label>
        <select asp-for="SocioId" asp-items="ViewBag.Socios as SelectList" class="form-select">
            <option value="">-- Seleccione un socio --</option>
        </select>
        <span asp-validation-for="SocioId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Libros disponibles</label>
        <div class="row">
            @foreach (var libro in (IEnumerable<lab_semana08.Models.Libro>)ViewBag.LibrosDisponibles)
            {
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="LibroIds" value="@libro.LibroId" id="libro-@libro.LibroId" />
                        <label class="form-check-label" for="libro-@libro.LibroId">
                            @libro.Titulo <span class="text-muted">(@libro.AutorNombre · @libro.Ejemplares disp.)</span>
                        </label>
                    </div>
                </div>
            }
        </div>
        <span asp-validation-for="LibroIds" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Registrar préstamo</button>
    <a asp-action="Reporte" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
